// GpuScanAdapter.cpp - 引擎 GPU 扫描/密度匹配提供者实现
#include "gpu/GpuScanAdapter.h"
#include "gpu/GpuSession.h"

#include "core/SlimeEngine.h" // 仅接口声明（slime::GpuScan / slime::Version），无链接依赖

#include <atomic>
#include <memory>
#include <string>
#include <utility>
#include <vector>

namespace slimegpu {

namespace {

class GpuScanAdapter final : public slime::GpuScan {
public:
    explicit GpuScanAdapter(std::unique_ptr<GpuSession> session)
        : m_session(std::move(session))
    {
    }

    bool available() const noexcept override
    {
        return m_session && m_session->available();
    }

    bool scanRect(slime::Version version, int64_t worldSeed, int minX, int minZ, int w, int h,
                  std::vector<uint8_t>& out, std::string* err) const override
    {
        if (!m_session || !m_session->available()) {
            if (err) *err = "GPU 会话不可用";
            return false;
        }
        if (version == slime::Version::Java) {
            return m_session->scanJava(worldSeed, minX, minZ, w, h, out, err);
        }
        return m_session->scanBedrock(minX, minZ, w, h, out, err);
    }

    // v3.3.1：GPU 密度匹配（区块判定 + 窗口密度统计都在显存内完成，只回传命中窗口）。
    // 语义与 CPU 精确模式逐位一致；不可用/失败/超上限返回 false（引擎回退 CPU）。
    bool matchDensity(const slime::DensityMatchParams& p, const std::atomic<bool>& cancel,
                      std::vector<slime::MatchResult>& out, std::string* err) const override
    {
        if (!m_session || !m_session->available()) {
            if (err) *err = "GPU 会话不可用";
            return false;
        }
        DensityMatchRequest req;
        req.version = (p.version == slime::Version::Java) ? 0 : 1;
        req.worldSeed = p.worldSeed;
        req.axMin = p.axMin;
        req.axMax = p.axMax;
        req.azMin = p.azMin;
        req.azMax = p.azMax;
        req.gridSize = p.gridSize;
        req.minDensity = p.minDensity;
        req.maxResults = p.maxResults;

        out.clear();
        std::vector<DensityHit> hits;
        std::string stat;
        const DensityMatchStatus st = m_session->matchDensity(req, cancel, hits, err, &stat);
        switch (st) {
        case DensityMatchStatus::Ok:
        case DensityMatchStatus::Cancelled:
            break;
        default:
            return false; // 失败/超上限：引擎回退 CPU
        }

        // MatchResult 与 CPU 写法完全一致：density = (float)count / (float)(g*g)
        const float denom = static_cast<float>(static_cast<int64_t>(p.gridSize) * p.gridSize);
        const int64_t g = p.gridSize;
        out.reserve(hits.size());
        for (const DensityHit& h : hits) {
            slime::MatchResult mr;
            mr.minX = h.x;
            mr.maxX = static_cast<int>(h.x + g - 1);
            mr.minZ = h.z;
            mr.maxZ = static_cast<int>(h.z + g - 1);
            mr.density = static_cast<float>(h.count) / denom;
            out.push_back(mr);
        }
        return true;
    }

private:
    mutable std::unique_ptr<GpuSession> m_session;
};

} // namespace

std::unique_ptr<slime::GpuScan> createGpuScanAdapter(std::string* err)
{
    auto session = std::make_unique<GpuSession>();
    if (!session->init(err)) return nullptr;
    return std::unique_ptr<slime::GpuScan>(new GpuScanAdapter(std::move(session)));
}

} // namespace slimegpu
