namespace slimegpu {

namespace {

// 调试开关：环境变量 SLIME_GPU_DEBUG=1（输出走 stderr，避免 stdout 缓冲丢失）
bool dbgEnv()
{
    const char* e = std::getenv("SLIME_GPU_DEBUG");
    return e && *e == '1';
}

std::string queryPlatformString(const ClApi& api, cl_platform_id p, cl_platform_info param)
{
    size_t sz = 0;
    if (api.pfnGetPlatformInfo(p, param, 0, nullptr, &sz) != CL_SUCCESS || sz == 0) return {};
    std::string s(sz, '\0');
    if (api.pfnGetPlatformInfo(p, param, sz, &s[0], nullptr) != CL_SUCCESS) return {};
    while (!s.empty() && s.back() == '\0') s.pop_back();
    return s;
}

std::string queryDeviceString(const ClApi& api, cl_device_id d, cl_device_info param)
{
    size_t sz = 0;
    if (api.pfnGetDeviceInfo(d, param, 0, nullptr, &sz) != CL_SUCCESS || sz == 0) return {};
    std::string s(sz, '\0');
    if (api.pfnGetDeviceInfo(d, param, sz, &s[0], nullptr) != CL_SUCCESS) return {};
    while (!s.empty() && s.back() == '\0') s.pop_back();
    return s;
}

template <typename T>
bool queryDevice(const ClApi& api, cl_device_id d, cl_device_info param, T& out)
{
    return api.pfnGetDeviceInfo(d, param, sizeof(T), &out, nullptr) == CL_SUCCESS;
}

// 设备可用性检查 + 信息填充；返回是否可用（CL_DEVICE_AVAILABLE == CL_TRUE）
bool fillDeviceInfo(const ClApi& api, cl_platform_id plat, cl_device_type type,
                    cl_device_id dev, GpuDeviceInfo& info)
{
    cl_bool avail = CL_FALSE;
    if (!queryDevice(api, dev, CL_DEVICE_AVAILABLE, avail)) return false;
    if (avail != CL_TRUE) return false;

    info.isGpu = (type & CL_DEVICE_TYPE_GPU) != 0;
    info.platformName = queryPlatformString(api, plat, CL_PLATFORM_NAME);
    info.platformVendor = queryPlatformString(api, plat, CL_PLATFORM_VENDOR);
    info.platformVersion = queryPlatformString(api, plat, CL_PLATFORM_VERSION);
    info.name = queryDeviceString(api, dev, CL_DEVICE_NAME);
    info.vendor = queryDeviceString(api, dev, CL_DEVICE_VENDOR);
    info.driverVersion = queryDeviceString(api, dev, CL_DRIVER_VERSION);
    info.deviceVersion = queryDeviceString(api, dev, CL_DEVICE_VERSION);
    info.extensions = queryDeviceString(api, dev, CL_DEVICE_EXTENSIONS);
    queryDevice(api, dev, CL_DEVICE_MAX_COMPUTE_UNITS, info.maxComputeUnits);
    queryDevice(api, dev, CL_DEVICE_MAX_CLOCK_FREQUENCY, info.maxClockMhz);
    queryDevice(api, dev, CL_DEVICE_GLOBAL_MEM_SIZE, info.globalMemBytes);
    queryDevice(api, dev, CL_DEVICE_LOCAL_MEM_SIZE, info.localMemBytes);
    queryDevice(api, dev, CL_DEVICE_MAX_WORK_GROUP_SIZE, info.maxWorkGroupSize);
    queryDevice(api, dev, CL_DEVICE_ADDRESS_BITS, info.addressBits);
    queryDevice(api, dev, CL_DEVICE_MAX_MEM_ALLOC_SIZE, info.maxMemAllocBytes);
    // 各维度工作组上限（size_t[3]）：2D kernel 的局部尺寸必须逐维满足
    {
        size_t dims[3] = { 0, 0, 0 };
        if (api.pfnGetDeviceInfo(dev, CL_DEVICE_MAX_WORK_ITEM_SIZES, sizeof(dims), dims, nullptr) == CL_SUCCESS) {
            info.maxWorkItemSizes[0] = dims[0];
            info.maxWorkItemSizes[1] = dims[1];
            info.maxWorkItemSizes[2] = dims[2];
        }
    }
    return true;
}

// 选择得分：GPU 远高于 CPU；同类内比较计算单元数 x 时钟
uint64_t deviceScore(const GpuDeviceInfo& info)
{
    uint64_t base = info.isGpu ? (1ULL << 52) : (1ULL << 30);
    return base + info.maxComputeUnits * 65536ULL + info.maxClockMhz;
}

std::string buildLog(const ClApi& api, cl_program prog, cl_device_id dev)
{
    cl_build_status st = CL_BUILD_NONE;
    if (api.pfnGetProgramBuildInfo(prog, dev, CL_PROGRAM_BUILD_STATUS, sizeof(st), &st, nullptr) != CL_SUCCESS) {
        return {};
    }
    size_t sz = 0;
    if (api.pfnGetProgramBuildInfo(prog, dev, CL_PROGRAM_BUILD_LOG, 0, nullptr, &sz) != CL_SUCCESS || sz == 0) {
        return {};
    }
    std::string s(sz, '\0');
    api.pfnGetProgramBuildInfo(prog, dev, CL_PROGRAM_BUILD_LOG, sz, &s[0], nullptr);
    return s;
}

} // namespace

// 持有全部 OpenCL 对象（不透明，避免向公共头泄漏 CL 类型）
struct GpuSession::Impl {
    std::mutex mu; // v3.2.0：引擎分块路径多线程并发调用扫描 → 串行化（GPU 单队列语义）
    ClApi api;
    cl_context ctx = nullptr;
    cl_command_queue queue = nullptr;
    cl_program program = nullptr;
    cl_kernel kJava = nullptr;
    cl_kernel kBedrock = nullptr;
    // v3.3.1 密度匹配内核
    cl_kernel kJavaBitmap = nullptr;    // Java 判定位图（列主序，64 行/段）
    cl_kernel kBedrockBitmap = nullptr; // 基岩判定位图
    cl_kernel kCountEmit = nullptr;     // 窗口计数 + 门限 + 命中写回
    cl_mem outBuf = nullptr;
    size_t outCap = 0;
    // v3.3.1 密度匹配缓冲（跨调用复用）
    cl_mem bitmapBuf = nullptr;
    size_t bitmapCap = 0;
    cl_mem resBuf = nullptr;
    size_t resCap = 0;      // 字节
    cl_mem cnt0 = nullptr;  // 原子命中计数
    cl_mem cnt1 = nullptr;  // 越限标志
    cl_platform_id platform = nullptr;
    cl_device_id device = nullptr;
};

GpuSession::~GpuSession()
{
    if (!m_impl) return;
    if (m_impl->kJava) m_impl->api.pfnReleaseKernel(m_impl->kJava);
    if (m_impl->kBedrock) m_impl->api.pfnReleaseKernel(m_impl->kBedrock);
    if (m_impl->kJavaBitmap) m_impl->api.pfnReleaseKernel(m_impl->kJavaBitmap);
    if (m_impl->kBedrockBitmap) m_impl->api.pfnReleaseKernel(m_impl->kBedrockBitmap);
    if (m_impl->kCountEmit) m_impl->api.pfnReleaseKernel(m_impl->kCountEmit);
    if (m_impl->kCountEmitDbg) m_impl->api.pfnReleaseKernel(m_impl->kCountEmitDbg);
    if (m_impl->program) m_impl->api.pfnReleaseProgram(m_impl->program);
    if (m_impl->outBuf) m_impl->api.pfnReleaseMemObject(m_impl->outBuf);
    if (m_impl->bitmapBuf) m_impl->api.pfnReleaseMemObject(m_impl->bitmapBuf);
    if (m_impl->resBuf) m_impl->api.pfnReleaseMemObject(m_impl->resBuf);
    if (m_impl->cnt0) m_impl->api.pfnReleaseMemObject(m_impl->cnt0);
    if (m_impl->cnt1) m_impl->api.pfnReleaseMemObject(m_impl->cnt1);
    if (m_impl->queue) m_impl->api.pfnReleaseCommandQueue(m_impl->queue);
    if (m_impl->ctx) m_impl->api.pfnReleaseContext(m_impl->ctx);
    m_impl->api.closeModule();
    delete m_impl;
    m_impl = nullptr;
}

bool GpuSession::init(std::string* err)
{
    // v3.2.1：异常兜底——OpenCL 驱动/库在异常机器上的任何 C++ 异常都转为失败返回，
    // 保证 GUI/引擎侧「不可用即回退 CPU」，绝不外抛导致崩溃。
    try {
        return initImpl(err);
    } catch (const std::exception& e) {
        m_lastError = std::string("GPU 初始化异常：") + e.what();
    } catch (...) {
        m_lastError = "GPU 初始化异常：未知错误";
    }
    if (err) *err = m_lastError;
    return false;
}

bool GpuSession::initImpl(std::string* err)
{
    if (err) err->clear();
    const bool dbg = dbgEnv();

    std::vector<std::string> modules;
    collectCandidateModules(modules);
    if (dbg) {
        std::fprintf(stderr, "[gpu-dbg] candidates: %zu\n", modules.size());
        for (const auto& m : modules) std::fprintf(stderr, "    %s\n", m.c_str());
    }

    // 依次尝试每个模块，记录（模块、平台、设备、得分）最优项
    ClApi bestApi;
    cl_platform_id bestPlatform = nullptr;
    cl_device_id bestDevice = nullptr;
    GpuDeviceInfo bestInfo;
    std::string bestModule;
    uint64_t bestScore = 0;

    for (const std::string& mod : modules) {
        ClApi trial;
        if (!trial.openModule(mod)) {
            if (dbg) std::fprintf(stderr, "[gpu-dbg] openModule FAILED: %s (err=%lu)\n", mod.c_str(),
                                  (unsigned long)GetLastError());
            continue;
        }
        if (dbg) std::fprintf(stderr, "[gpu-dbg] openModule OK: %s\n", mod.c_str());

        cl_uint np = 0;
        cl_int prc = trial.pfnGetPlatformIDs(0, nullptr, &np);
        if (prc != CL_SUCCESS || np == 0) {
            if (dbg) std::fprintf(stderr, "[gpu-dbg]   platforms=0 (rc=%d)\n", (int)prc);
            trial.closeModule();
            continue;
        }
        std::vector<cl_platform_id> plats(np);
        if (trial.pfnGetPlatformIDs(np, plats.data(), &np) != CL_SUCCESS || np == 0) {
            trial.closeModule();
            continue;
        }
        if (dbg) std::fprintf(stderr, "[gpu-dbg]   platforms=%u\n", np);

        // 模块内先选最优（同一模块只需提交一次函数表）
        cl_platform_id localPlat = nullptr;
        cl_device_id localDev = nullptr;
        GpuDeviceInfo localInfo;
        uint64_t localScore = 0;

        const cl_device_type kinds[2] = {CL_DEVICE_TYPE_GPU, CL_DEVICE_TYPE_CPU};
        int platIdx = 0;
        for (cl_platform_id plat : plats) {
            if (dbg) {
                std::string pn = queryPlatformString(trial, plat, CL_PLATFORM_NAME);
                std::fprintf(stderr, "[gpu-dbg]     platform[%d] %s\n", platIdx, pn.c_str());
            }
            ++platIdx;
            for (cl_device_type kind : kinds) {
                cl_uint nd = 0;
                cl_int drc = trial.pfnGetDeviceIDs(plat, kind, 0, nullptr, &nd);
                if (drc != CL_SUCCESS || nd == 0) {
                    if (dbg) std::fprintf(stderr, "[gpu-dbg]       devs %s=0 (rc=%d)\n",
                                          (kind & CL_DEVICE_TYPE_GPU) ? "GPU" : "CPU", (int)drc);
                    continue;
                }
                std::vector<cl_device_id> devs(nd);
                if (trial.pfnGetDeviceIDs(plat, kind, nd, devs.data(), &nd) != CL_SUCCESS) continue;
                if (dbg) std::fprintf(stderr, "[gpu-dbg]       devs %s=%u\n",
                                      (kind & CL_DEVICE_TYPE_GPU) ? "GPU" : "CPU", nd);
                for (cl_device_id dev : devs) {
                    if (dbg) {
                        std::string dn = queryDeviceString(trial, dev, CL_DEVICE_NAME);
                        cl_bool av = CL_FALSE;
                        trial.pfnGetDeviceInfo(dev, CL_DEVICE_AVAILABLE, sizeof(av), &av, nullptr);
                        std::fprintf(stderr, "[gpu-dbg]         dev \"%s\" available=%d\n", dn.c_str(), (int)av);
                    }
                    GpuDeviceInfo info;
                    if (!fillDeviceInfo(trial, plat, kind, dev, info)) continue;
                    uint64_t score = deviceScore(info);
                    if (score > localScore) {
                        localScore = score;
                        localInfo = std::move(info);
                        localPlat = plat;
                        localDev = dev;
                    }
                }
            }
        }

        if (localDev && localScore > bestScore) {
            bestApi.closeModule(); // 释放先前接管（若有）的模块
            bestScore = localScore;
            bestInfo = std::move(localInfo);
            bestPlatform = localPlat;
            bestDevice = localDev;
            bestModule = mod;
            bestApi = std::move(trial);
        }
        trial.closeModule(); // 已接管时 module 为空，安全无操作

        // 已获得可用 GPU 即停止：同一驱动被多次加载（loader 派发 + 直连）会破坏运行时状态
        if (bestDevice && bestInfo.isGpu) {
            if (dbg) std::fprintf(stderr, "[gpu-dbg] adopt GPU done, stop scanning\n");
            break;
        }
    }

    if (!bestDevice) {
        m_lastError = "未找到可用的 OpenCL 设备（已尝试 " + std::to_string(modules.size()) + " 个模块）";
        if (err) *err = m_lastError;
        return false;
    }
    if (dbg) std::fprintf(stderr, "[gpu-dbg] adopt module=%s device=%s\n",
                          bestModule.c_str(), bestInfo.name.c_str());

    m_impl = new Impl();
    m_impl->api = std::move(bestApi);
    m_impl->platform = bestPlatform;
    m_impl->device = bestDevice;
    m_device = std::move(bestInfo);
    m_modulePath = std::move(bestModule);

    // context（绑定平台）+ 命令队列
    cl_context_properties props[3] = {CL_CONTEXT_PLATFORM,
                                      reinterpret_cast<cl_context_properties>(bestPlatform), 0};
    cl_int rc = CL_SUCCESS;
    if (dbg) {
        auto& api = m_impl->api;
        HMODULE hmod = (HMODULE)api.module;
        const unsigned char* ep = (const unsigned char*)api.pfnCreateContext;
        std::fprintf(stderr, "[gpu-dbg] clCreateContext... pfn=%p module=%p firstbytes=%02X %02X %02X %02X %02X %02X %02X %02X\n",
                     (void*)api.pfnCreateContext, (void*)hmod,
                     ep[0], ep[1], ep[2], ep[3], ep[4], ep[5], ep[6], ep[7]);
    }
    m_impl->ctx = m_impl->api.pfnCreateContext(props, 1, &m_impl->device, nullptr, nullptr, &rc);
    if (dbg) std::fprintf(stderr, "[gpu-dbg] clCreateContext rc=%d ctx=%p\n", (int)rc, (void*)m_impl->ctx);
    if (!m_impl->ctx || rc != CL_SUCCESS) {
        m_lastError = std::string("clCreateContext 失败: ") + clErrorText(rc);
        if (err) *err = m_lastError;
        delete m_impl;
        m_impl = nullptr;
        return false;
    }
    if (dbg) std::fprintf(stderr, "[gpu-dbg] clCreateCommandQueue...\n");
    m_impl->queue = m_impl->api.pfnCreateCommandQueue(m_impl->ctx, m_impl->device, 0, &rc);
    if (dbg) std::fprintf(stderr, "[gpu-dbg] clCreateCommandQueue rc=%d queue=%p\n", (int)rc, (void*)m_impl->queue);
    if (!m_impl->queue || rc != CL_SUCCESS) {
        m_lastError = std::string("clCreateCommandQueue 失败: ") + clErrorText(rc);
        if (err) *err = m_lastError;
        delete m_impl;
        m_impl = nullptr;
        return false;
    }
    if (dbg) std::fprintf(stderr, "[gpu-dbg] buildProgram...\n");

    if (!buildProgram(err)) {
        delete m_impl;
        m_impl = nullptr;
        return false;
    }

    m_ready = true;
    return true;
}

bool GpuSession::buildProgram(std::string* err)
{
    cl_int rc = CL_SUCCESS;
    const char* src = kSlimeKernelSource;
    size_t srcLen = std::strlen(src);
    m_impl->program = m_impl->api.pfnCreateProgramWithSource(m_impl->ctx, 1, &src, &srcLen, &rc);
    if (!m_impl->program || rc != CL_SUCCESS) {
        m_lastError = std::string("clCreateProgramWithSource 失败: ") + clErrorText(rc);
        if (err) *err = m_lastError;
        return false;
    }
    rc = m_impl->api.pfnBuildProgram(m_impl->program, 1, &m_impl->device, nullptr, nullptr, nullptr);
    m_kernelBuildLog = buildLog(m_impl->api, m_impl->program, m_impl->device);
    if (dbgEnv()) std::fprintf(stderr, "[gpu-dbg] clBuildProgram rc=%d loglen=%zu\n", (int)rc,
                               m_kernelBuildLog.size());
    if (rc != CL_SUCCESS) {
        m_lastError = std::string("内核编译失败: ") + clErrorText(rc);
        if (!m_kernelBuildLog.empty()) {
            m_lastError += "\n--- 构建日志 ---\n" + m_kernelBuildLog;
        }
        if (err) *err = m_lastError;
        return false;
    }
    m_impl->kJava = m_impl->api.pfnCreateKernel(m_impl->program, "scan_java_slime", &rc);
    if (!m_impl->kJava || rc != CL_SUCCESS) {
        m_lastError = std::string("clCreateKernel(scan_java_slime) 失败: ") + clErrorText(rc);
        if (err) *err = m_lastError;
        return false;
    }
    m_impl->kBedrock = m_impl->api.pfnCreateKernel(m_impl->program, "scan_bedrock_slime", &rc);
    if (!m_impl->kBedrock || rc != CL_SUCCESS) {
        m_lastError = std::string("clCreateKernel(scan_bedrock_slime) 失败: ") + clErrorText(rc);
        if (err) *err = m_lastError;
        return false;
    }
    // v3.3.1：密度匹配内核（三段流水线）
    struct KernelRef {
        cl_kernel* slot;
        const char* name;
    };
    const KernelRef densityKernels[] = {
        { &m_impl->kJavaBitmap, "scan_java_bitmap" },
        { &m_impl->kBedrockBitmap, "scan_bedrock_bitmap" },
        { &m_impl->kCountEmit, "density_count_emit" },
        { &m_impl->kCountEmitDbg, "density_count_emit_dbg" },
    };
    for (const KernelRef& k : densityKernels) {
        *k.slot = m_impl->api.pfnCreateKernel(m_impl->program, k.name, &rc);
        if (!*k.slot || rc != CL_SUCCESS) {
            m_lastError = std::string("clCreateKernel(") + k.name + ") 失败: " + clErrorText(rc);
            if (err) *err = m_lastError;
            return false;
        }
    }
    return true;
}

bool GpuSession::ensureOutBuffer(size_t bytes, std::string* err)
{
    if (m_impl->outCap >= bytes && m_impl->outBuf) return true;
    if (m_impl->outBuf) {
        m_impl->api.pfnReleaseMemObject(m_impl->outBuf);
        m_impl->outBuf = nullptr;
        m_impl->outCap = 0;
    }
    cl_int rc = CL_SUCCESS;
    m_impl->outBuf = m_impl->api.pfnCreateBuffer(m_impl->ctx, CL_MEM_READ_WRITE, bytes, nullptr, &rc);
    if (!m_impl->outBuf || rc != CL_SUCCESS) {
        m_lastError = std::string("clCreateBuffer 失败: ") + clErrorText(rc);
        if (err) *err = m_lastError;
        return false;
    }
    m_impl->outCap = bytes;
    return true;
}

bool GpuSession::runScan(int version, int64_t seed, int minX, int minZ, int w, int h,
                         std::vector<uint8_t>& out, std::string* err)
{
    if (!m_ready || !m_impl) {
        m_lastError = "GPU 会话未就绪";
        if (err) *err = m_lastError;
        return false;
    }
    if (w <= 0 || h <= 0) {
        m_lastError = "非法扫描尺寸";
        if (err) *err = m_lastError;
        return false;
    }
    const size_t bytes = static_cast<size_t>(w) * static_cast<size_t>(h);
    std::lock_guard<std::mutex> lock(m_impl->mu); // 引擎多线程（分块路径）并发安全
    if (!ensureOutBuffer(bytes, err)) return false;

    cl_kernel k = (version == 0) ? m_impl->kJava : m_impl->kBedrock;
    cl_int rc = CL_SUCCESS;
    const auto setArg = [&](cl_uint idx, size_t sz, const void* v) {
        rc = m_impl->api.pfnSetKernelArg(k, idx, sz, v);
        return rc == CL_SUCCESS;
    };

    if (version == 0) {
        if (!setArg(0, sizeof(seed), &seed)) goto fail;
        if (!setArg(1, sizeof(minX), &minX)) goto fail;
        if (!setArg(2, sizeof(minZ), &minZ)) goto fail;
        if (!setArg(3, sizeof(w), &w)) goto fail;
        if (!setArg(4, sizeof(h), &h)) goto fail;
        if (!setArg(5, sizeof(cl_mem), &m_impl->outBuf)) goto fail;
    } else {
        if (!setArg(0, sizeof(minX), &minX)) goto fail;
        if (!setArg(1, sizeof(minZ), &minZ)) goto fail;
        if (!setArg(2, sizeof(w), &w)) goto fail;
        if (!setArg(3, sizeof(h), &h)) goto fail;
        if (!setArg(4, sizeof(cl_mem), &m_impl->outBuf)) goto fail;
    }

    {
        size_t global = bytes;
        rc = m_impl->api.pfnEnqueueNDRangeKernel(m_impl->queue, k, 1, nullptr, &global, nullptr,
                                                 0, nullptr, nullptr);
        if (rc != CL_SUCCESS) {
            m_lastError = std::string("clEnqueueNDRangeKernel 失败: ") + clErrorText(rc);
            if (err) *err = m_lastError;
            return false;
        }
        rc = m_impl->api.pfnFinish(m_impl->queue);
        if (rc != CL_SUCCESS) {
            m_lastError = std::string("clFinish 失败: ") + clErrorText(rc);
            if (err) *err = m_lastError;
            return false;
        }
        out.resize(bytes);
        rc = m_impl->api.pfnEnqueueReadBuffer(m_impl->queue, m_impl->outBuf, CL_TRUE, 0, bytes,
                                              out.data(), 0, nullptr, nullptr);
        if (rc != CL_SUCCESS) {
            m_lastError = std::string("clEnqueueReadBuffer 失败: ") + clErrorText(rc);
            if (err) *err = m_lastError;
            return false;
        }
    }
    return true;

fail:
    m_lastError = std::string("clSetKernelArg 失败: ") + clErrorText(rc);
    if (err) *err = m_lastError;
    return false;
}

bool GpuSession::scanJava(int64_t worldSeed, int minX, int minZ, int w, int h,
                          std::vector<uint8_t>& out, std::string* err)
{
    return runScan(0, worldSeed, minX, minZ, w, h, out, err);
}

bool GpuSession::scanBedrock(int minX, int minZ, int w, int h,
                             std::vector<uint8_t>& out, std::string* err)
{
    return runScan(1, 0, minX, minZ, w, h, out, err);
}

// ============================ v3.3.1：GPU 密度匹配辅助 ============================

namespace {

// 写入型缓冲：容量足够则复用，不足则重建（只增不减，避免反复分配）
bool ensureWriteBuffer(const ClApi& api, cl_context ctx, cl_mem& buf, size_t& cap,
                       size_t bytes, const char* what, std::string& err)
{
    if (cap >= bytes && buf) return true;
    if (buf) {
        api.pfnReleaseMemObject(buf);
        buf = nullptr;
        cap = 0;
    }
    cl_int rc = CL_SUCCESS;
    buf = api.pfnCreateBuffer(ctx, CL_MEM_READ_WRITE, bytes, nullptr, &rc);
    if (!buf || rc != CL_SUCCESS) {
        err = std::string("clCreateBuffer(") + what + ", " + std::to_string(bytes) +
              " 字节) 失败: " + clErrorText(rc);
        return false;
    }
    cap = bytes;
    return true;
}

// 内核参数设置的小包装（失败即停止并记录错误码）
struct ArgSetter {
    const ClApi& api;
    cl_kernel k = nullptr;
    cl_int rc = CL_SUCCESS;
    cl_uint idx = 0;
    bool ok = true;

    void put(size_t sz, const void* v)
    {
        if (!ok) return;
        rc = api.pfnSetKernelArg(k, idx++, sz, v);
        if (rc != CL_SUCCESS) ok = false;
    }
    template <typename T>
    void put(const T& v)
    {
        put(sizeof(T), &v);
    }
};

// 内核入参的 64 位类型映射：OpenCL 的 long/ulong 在主机侧与 int64_t/uint64_t 同宽，
// 直接用定宽类型传参（cl_long/cl_ulong 的 typedef 在部分平台上被 windows.h 的宏污染）。
static_assert(sizeof(int64_t) == 8 && sizeof(uint64_t) == 8, "需要 64 位定宽整数");
inline int64_t clL(int64_t v) { return v; }
inline uint64_t clU(uint64_t v) { return v; }

inline std::string argError(const char* what, cl_int rc)
{
    return std::string(what) + ": " + clErrorText(rc);
}

// 选取一维局部工作组大小：≤ 设备上限、≥1、且整除 global
// （OpenCL 1.2 要求 global 能被 local 整除，否则报 CL_INVALID_WORK_GROUP_SIZE）。
size_t pickLocal1D(size_t global, uint64_t deviceMax, size_t want)
{
    if (global == 0) return 1;
    size_t cap = static_cast<size_t>(deviceMax > 0 ? deviceMax : 1);
    if (cap > want) cap = want;
    for (size_t l = cap; l > 0; l >>= 1) {
        if ((global % l) == 0) return l;
    }
    return 1;
}

} // namespace

// ============================ v3.3.1：GPU 密度匹配 ============================
//
// 流程（分块流式，单块 ≤512MB，中间数据只留在显存）：
//   外层按 x 切块（锚点列数上限），内层按 z 切块（位图行数上限）；
//   块内再按 x 分子块提交「判定位图」，以便「取消」与「maxResults 超限」在 ~几十毫秒内被察觉；
//   位图就绪后一次 density_count_emit 完成「窗口计数 + 门限 + 命中写回」。
//
// 与 CPU 精确模式的一致性要点：
//   * 计数为整数（位运算 popcount + 滑动窗口求和），门限用整数等价式 count·g² ≥ ⌈minDensity·g²⌉·g²；
//   * density 由主机按 CPU 写法 (float)count / (float)(g*g) 计算；
//   * 每个锚点的窗口 = [x, x+g) × [z, z+g)，越出位图范围的列按「全 0 列」处理（不影响计数，
//     因为这些位置本就不属于本块的窗口），窗口行域严格限制在 [az0, az1+g-1] 内。
DensityMatchStatus GpuSession::matchDensity(const DensityMatchRequest& req,
                                            const std::atomic<bool>& cancel,
                                            std::vector<DensityHit>& out,
                                            std::string* err,
                                            std::string* stats)
{
    out.clear();
    const auto fail = [&](const std::string& msg) {
        m_lastError = msg;
        if (err) *err = msg;
        return DensityMatchStatus::Failed;
    };

    if (!m_ready || !m_impl) return fail("GPU 会话未就绪");
    if (req.gridSize < 1 || req.gridSize > 512) return fail("网格边长必须在 1..512");
    if (req.axMax < req.axMin || req.azMax < req.azMin) {
        if (err) err->clear();
        return DensityMatchStatus::Ok; // 空范围
    }
    if (req.version != 0 && req.version != 1) return fail("未知的版本参数");

    const int64_t g64 = req.gridSize;
    const int64_t spanX = req.axMax - req.axMin + 1;
    const int64_t spanZ = req.azMax - req.azMin + 1;

    // 坐标安全：内核用 int 表示区块坐标，位图左侧 padding 会外扩 g-1 列
    constexpr int64_t kCoordLimit = 2147480000LL;
    if (req.axMin - (g64 - 1) < -kCoordLimit || req.axMax + (g64 - 1) > kCoordLimit ||
        req.azMin - (g64 - 1) < -kCoordLimit || req.azMax + (g64 - 1) > kCoordLimit) {
        return fail("锚点范围超出 GPU 内核可表示坐标（|坐标| 上限约 2.147e9）");
    }

    std::lock_guard<std::mutex> lock(m_impl->mu);
    Impl& im = *m_impl;
    const ClApi& api = im.api;

    // ---- 分块预算：默认 min(512MB, 1/8 显存, 1/4 单次分配上限)，SLIME_GPU_TILE_BYTES 可覆盖 ----
    // 注意：Windows 头把 min/max 定义成宏，这里只用整数比较。
    constexpr uint64_t kHardTileCap = 512ull << 20;
    constexpr uint64_t kMinTile = 16ull << 20;
    uint64_t tileBytes = kHardTileCap;
    const uint64_t memEighth = m_device.globalMemBytes / 8;
    const uint64_t allocQuarter = m_device.maxMemAllocBytes / 4;
    if (m_device.globalMemBytes > 0 && memEighth < tileBytes) tileBytes = memEighth;
    if (m_device.maxMemAllocBytes > 0 && allocQuarter < tileBytes) tileBytes = allocQuarter;
    if (tileBytes < kMinTile) tileBytes = kMinTile;
    if (const char* env = std::getenv("SLIME_GPU_TILE_BYTES")) {
        const long long v = std::atoll(env);
        if (v > 0) tileBytes = static_cast<uint64_t>(v);
    }
    if (tileBytes > kHardTileCap) tileBytes = kHardTileCap;

    // 内核限制：单 work-group 覆盖 ≤128 个 64 行段（8192 行）；位图列数上限按显存预算收缩
    constexpr int64_t kMaxWordsPerGroup = 128;
    const int64_t maxTileCols = 32768;

    // 门限：⌈minDensity·g²⌉·g²（整数比较，严格等价于 (double)count/(double)(g*g) ≥ minDensity）
    const double gd = static_cast<double>(g64);
    const double needD = std::ceil(req.minDensity * gd * gd);
    const uint64_t needInt = (needD <= 0.0) ? 0ull : static_cast<uint64_t>(needD);
    const uint64_t needScaled = needInt * static_cast<uint64_t>(g64 * g64);

    // 本块位图字节数：列数 = 锚点列数（64 对齐）+ (g-1) 右侧 padding；nRows = zSpan + g - 1
    const auto bitmapBytesFor = [&](int64_t cols, int64_t nWords) -> uint64_t {
        const int64_t aligned = ((cols + 63) / 64) * 64;
        return static_cast<uint64_t>(aligned + (g64 - 1)) * static_cast<uint64_t>(nWords) * 8ull;
    };

    const auto tStart = std::chrono::steady_clock::now();
    uint64_t launchedChunks = 0;
    uint64_t tileCount = 0;
    std::string stat;
    // 取消/超限检查粒度：每个子块约 1600 万次判定（本机 GPU 上约 20~40ms）
    const int64_t chunkCells = 16ll * 1024 * 1024;
    // 结果缓冲：16 字节/条，最多 4M 条（64MB）
    const uint32_t resCap = 4u * 1024u * 1024u;

    for (int64_t ax0 = req.axMin; ax0 <= req.axMax;) {
        int64_t tx = std::min<int64_t>(maxTileCols, req.axMax - ax0 + 1);
        while (tx > 1 && bitmapBytesFor(tx, 1) * 8ull > tileBytes) tx = (tx + 1) / 2;
        const int64_t ax1 = ax0 + tx - 1;

        for (int64_t az0 = req.azMin; az0 <= req.azMax;) {
            if (cancel.load(std::memory_order_relaxed)) {
                if (err) err->clear();
                if (stats) *stats = stat + "（用户取消）";
                return DensityMatchStatus::Cancelled;
            }

            // z 块：保证 nWords ≤ 128（内核本地内存上限）
            int64_t tz = req.azMax - az0 + 1;
            for (;;) {
                const int64_t nw = (tz + (g64 - 1) + 63) / 64;
                if (nw <= kMaxWordsPerGroup && bitmapBytesFor(tx, nw) <= tileBytes) break;
                if (tz <= 1) break;
                tz = (tz + 1) / 2;
            }
            if (tz < 1) tz = 1;
            const int64_t az1 = az0 + tz - 1;
            const int64_t nRows = (az1 - az0 + 1) + (g64 - 1); // 窗口行域长度
            const int64_t nWords = (nRows + 63) / 64;
            if (nWords > kMaxWordsPerGroup) {
                tz = std::max<int64_t>(1, kMaxWordsPerGroup * 64 - (g64 - 1));
                continue;
            }
            const int64_t alignedCols = ((tx + 63) / 64) * 64;
            const int64_t cols = alignedCols + (g64 - 1); // 需判定的列数（含右 padding）
            const uint64_t bitmapBytes = bitmapBytesFor(tx, nWords);
            if (bitmapBytes > tileBytes) return fail("显存预算不足：单块位图超出上限");

            if (!ensureWriteBuffer(api, im.ctx, im.bitmapBuf, im.bitmapCap, static_cast<size_t>(bitmapBytes),
                                   "bitmap", m_lastError)) {
                return fail(m_lastError);
            }
            if (!ensureWriteBuffer(api, im.ctx, im.resBuf, im.resCap, static_cast<size_t>(resCap) * 16ull,
                                   "results", m_lastError)) {
                return fail(m_lastError);
            }
            if (!im.cnt0 || !im.cnt1) {
                cl_int rc = CL_SUCCESS;
                im.cnt0 = api.pfnCreateBuffer(im.ctx, CL_MEM_READ_WRITE, 256, nullptr, &rc);
                im.cnt1 = api.pfnCreateBuffer(im.ctx, CL_MEM_READ_WRITE, 256, nullptr, &rc);
                if (!im.cnt0 || !im.cnt1) return fail("clCreateBuffer(计数器) 失败");
            }

            // ---------- 1) 判定位图（按 x 分子块提交，便于及时取消/超限） ----------
            bool tileCancelled = false;
            bool tileTooMany = false;
            // 位图首列的实际区块 x：第一块锚点的窗口首列 = ax0 - (g-1)
            const int64_t xFirst = ax0 - (g64 - 1);
            for (int64_t xs = 0; xs < cols && !tileCancelled && !tileTooMany; xs += chunkCells) {
                const int64_t cnt = std::min<int64_t>(chunkCells, cols - xs);
                const int cu0 = static_cast<int>(xFirst + xs);
                cl_kernel k = (req.version == 0) ? im.kJavaBitmap : im.kBedrockBitmap;
                ArgSetter a{ api, k };
                if (req.version == 0) a.put(clL(req.worldSeed));
                a.put(clL(static_cast<int64_t>(cu0)));
                a.put(clL(az0));
                a.put(static_cast<int>(cnt));
                a.put(static_cast<int>(nWords));
                a.put(im.bitmapBuf);
                if (!a.ok) return fail(argError("clSetKernelArg(位图内核) 失败", a.rc));
                size_t global = static_cast<size_t>(cnt) * static_cast<size_t>(nWords);
                const size_t local = pickLocal1D(global, m_device.maxWorkGroupSize, 256);
                const cl_int rc = api.pfnEnqueueNDRangeKernel(im.queue, k, 1, nullptr, &global, &local, 0,
                                                              nullptr, nullptr);
                if (rc != CL_SUCCESS) return fail(std::string("位图内核执行失败: ") + clErrorText(rc));
                if (api.pfnFinish(im.queue) != CL_SUCCESS) return fail("clFinish 失败（位图）");
                ++launchedChunks;
                if (cancel.load(std::memory_order_relaxed)) {
                    tileCancelled = true;
                    break;
                }
            }
            if (tileCancelled) {
                if (err) err->clear();
                if (stats) *stats = stat + "（用户取消）";
                return DensityMatchStatus::Cancelled;
            }

            // ---------- 2) 窗口计数 + 门限 + 命中写回（一个 work-group 一个锚点列） ----------
            uint32_t hits = 0;
            {
                uint32_t zero = 0;
                if (api.pfnEnqueueWriteBuffer(im.queue, im.cnt0, CL_TRUE, 0, sizeof(zero), &zero, 0, nullptr,
                                              nullptr) != CL_SUCCESS ||
                    api.pfnEnqueueWriteBuffer(im.queue, im.cnt1, CL_TRUE, 0, sizeof(zero), &zero, 0, nullptr,
                                              nullptr) != CL_SUCCESS) {
                    return fail("清零原子计数器失败");
                }
                ArgSetter a{ api, im.kCountEmit };
                a.put(im.bitmapBuf);
                a.put(static_cast<int>(nWords));
                a.put(static_cast<int>(xFirst));
                a.put(static_cast<int>(tx));
                a.put(static_cast<int>(req.gridSize));
                a.put(clL(az0));
                a.put(clL(0));                 // ay0：窗口行域起点（区域内行号 0）
                a.put(clL(nRows - 1));         // ay1：窗口行域终点（含）
                a.put(static_cast<int>(g64 - 1));           // bx0：第一个锚点的窗口首列
                a.put(static_cast<int>(g64 - 1 + (g64 - 1))); // bx1 = bx0 + (g-1)：窗口末列相对锚点列
                a.put(clU(needScaled));
                a.put(clU(req.maxResults > 0 ? static_cast<uint64_t>(req.maxResults) : 0ull));
                a.put(im.cnt1);
                a.put(im.cnt0);
                a.put(im.resBuf);
                a.put(static_cast<uint32_t>(resCap));
                if (!a.ok) return fail(argError("clSetKernelArg(密度内核) 失败", a.rc));

                const size_t global = static_cast<size_t>(tx);
                size_t local = pickLocal1D(global, m_device.maxWorkGroupSize, 256);
                // work-group 大小需 ≤ 设备上限且能让每线程分到至少一个段（nWords ≤ local 时也能工作）
                if (local < 1) local = 1;
                const cl_int rc = api.pfnEnqueueNDRangeKernel(im.queue, im.kCountEmit, 1, nullptr, &global,
                                                              &local, 0, nullptr, nullptr);
                if (rc != CL_SUCCESS) return fail(std::string("密度内核执行失败: ") + clErrorText(rc));
                if (api.pfnFinish(im.queue) != CL_SUCCESS) return fail("clFinish 失败（密度）");
                if (api.pfnEnqueueReadBuffer(im.queue, im.cnt0, CL_TRUE, 0, sizeof(hits), &hits, 0, nullptr,
                                             nullptr) != CL_SUCCESS) {
                    return fail("读取命中总数失败");
                }
            }

            // 超限：累计命中超过 maxResults → 立即失败（引擎回退 CPU 全量路径，绝不返回截断结果）
            const int64_t total = static_cast<int64_t>(out.size()) + static_cast<int64_t>(hits);
            if (req.maxResults > 0 && total > req.maxResults) {
                out.clear();
                return fail("命中数超过 GPU 返回上限（maxResults=" + std::to_string(req.maxResults) +
                            "），请回退 CPU 全量路径");
            }
            if (hits > resCap) {
                out.clear();
                return fail("GPU 结果缓冲已满（命中数 " + std::to_string(hits) + "）");
            }

            if (const char* dbgRec = std::getenv("SLIME_GPU_DUMP_RECS")) {
                std::vector<uint32_t> rr(static_cast<size_t>(hits) * 4u, 0u);
                api.pfnEnqueueReadBuffer(im.queue, im.resBuf, CL_TRUE, 0, rr.size() * 4u, rr.data(), 0, nullptr,
                                         nullptr);
                std::FILE* f = std::fopen(dbgRec, "ab");
                if (f) {
                    std::fprintf(f, "# tile ax0=%lld az0=%lld g=%lld nRows=%lld hits=%u\n", (long long)ax0,
                                 (long long)az0, (long long)g64, (long long)nRows, (unsigned)hits);
                    for (uint32_t i = 0; i < hits; ++i) {
                        std::fprintf(f, "  count=%u x=%u zrel=%u\n", rr[i * 4u], rr[i * 4u + 1], rr[i * 4u + 2]);
                    }
                    std::fclose(f);
                }
            }
            if (hits > 0) {
                std::vector<uint32_t> recs(static_cast<size_t>(hits) * 4u);
                if (api.pfnEnqueueReadBuffer(im.queue, im.resBuf, CL_TRUE, 0, recs.size() * sizeof(uint32_t),
                                             recs.data(), 0, nullptr, nullptr) != CL_SUCCESS) {
                    return fail("读取命中记录失败");
                }
                out.reserve(out.size() + hits);
                for (uint32_t i = 0; i < hits; ++i) {
                    const uint32_t* r = &recs[static_cast<size_t>(i) * 4u];
                    DensityHit h;
                    h.count = r[0];
                    h.x = static_cast<int32_t>(r[1]);
                    h.z = static_cast<int32_t>(az0 + static_cast<int64_t>(r[2]));
                    out.push_back(h);
                }
            }

            ++tileCount;
            if (const char* dbgDump = std::getenv("SLIME_GPU_DUMP_BITMAP")) {
                // 排障：把本块位图导出到文件（列数/段数 + 原始 ulong）
                const size_t words = static_cast<size_t>(cols) * static_cast<size_t>(nWords);
                std::vector<uint64_t> bmp(words, 0ull);
                api.pfnEnqueueReadBuffer(im.queue, im.bitmapBuf, CL_TRUE, 0, words * 8u, bmp.data(), 0, nullptr,
                                         nullptr);
                std::FILE* f = std::fopen(dbgDump, "ab");
                if (f) {
                    std::fprintf(f, "# tile ax0=%lld cols=%lld nWords=%lld nRows=%lld xFirst=%lld hints=%u\n",
                                 (long long)ax0, (long long)cols, (long long)nWords, (long long)nRows,
                                 (long long)xFirst, (unsigned)hits);
                    for (size_t i = 0; i < words; ++i) {
                        std::fprintf(f, "%016llX\n", (unsigned long long)bmp[i]);
                    }
                    std::fclose(f);
                }
            }
            if (cancel.load(std::memory_order_relaxed)) {
                if (err) err->clear();
                if (stats) *stats = stat + "（用户取消）";
                return DensityMatchStatus::Cancelled;
            }
            if (dbgEnv()) {
                std::fprintf(stderr,
                             "[gpu-dbg] tile x=[%lld,%lld] z=[%lld,%lld] cols=%lld nWords=%lld bitmap=%.1fMB "
                             "hits=%u total=%zu\n",
                             (long long)ax0, (long long)ax1, (long long)az0, (long long)az1,
                             (long long)cols, (long long)nWords, bitmapBytes / 1048576.0, (unsigned)hits,
                             out.size());
            }
            az0 = az1 + 1;
        }
        ax0 = ax1 + 1;
    }

    const auto tEnd = std::chrono::steady_clock::now();
    const double ms = std::chrono::duration<double, std::milli>(tEnd - tStart).count();
    const double anchors = static_cast<double>(spanX) * static_cast<double>(spanZ);
    char buf[256];
    std::snprintf(buf, sizeof(buf),
                  "锚点 %lld×%lld = %.6g | 分块 %llu | 子块 %llu | 命中 %zu | 用时 %.1f ms | %.1f M锚点/s",
                  (long long)spanX, (long long)spanZ, anchors, (unsigned long long)tileCount,
                  (unsigned long long)launchedChunks, out.size(), ms,
                  ms > 0.0 ? anchors / ms / 1000.0 : 0.0);
    stat = std::string(buf) + (stat.empty() ? std::string() : std::string("\n")) + stat;
    if (stats) *stats = stat;
    if (dbgEnv()) std::fprintf(stderr, "[gpu-dbg] %s\n", buf);
    if (err) err->clear();
    return DensityMatchStatus::Ok;
}

} // namespace slimegpu

