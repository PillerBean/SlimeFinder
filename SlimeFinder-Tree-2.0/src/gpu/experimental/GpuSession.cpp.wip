#include "gpu/GpuSession.h"
#include "gpu/ClApi.h"
#include "slime_kernel_embed.h" // 生成的 kSlimeKernelSource（源自 slime_kernel.cl）

#define WIN32_LEAN_AND_MEAN
#include <windows.h>

#include <algorithm>
#include <chrono>
#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <exception>
