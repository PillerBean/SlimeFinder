# embed_kernel.cmake - embed slime_kernel.cl into a C++ header, byte-exactly
# usage: cmake -DKERNEL_IN=<path.cl> -DKERNEL_OUT=<path.h> -P embed_kernel.cmake
#
# v3.3.1: read as HEX, emit 3-digit octal escapes (one per byte).
# Why: CMake file(READ)/file(WRITE) may re-encode text on Windows (UTF-8 -> ANSI),
#      which used to ship mojibake comments into the OpenCL compiler. With octal
#      escapes the generated header is pure ASCII and kSlimeKernelSource is
#      byte-identical to the .cl file, independent of source encoding/codepage.
#
# v3.3.1 fix: the source lines of the generated header are *adjacent string
#      literals* joined by real newlines in the header text. An earlier revision
#      appended a "\n" escape at every wrap point, which injected a real newline
#      character into the embedded kernel every 24 bytes (breaking comments and
#      identifiers for the OpenCL compiler). Never emit escape characters here.
#
# The script also self-checks: it decodes its own octal escapes back to hex and
# aborts if the result differs from the input byte stream.
if(NOT DEFINED KERNEL_IN OR NOT DEFINED KERNEL_OUT)
    message(FATAL_ERROR "usage: cmake -DKERNEL_IN=file.cl -DKERNEL_OUT=file.h -P embed_kernel.cmake")
endif()

file(READ "${KERNEL_IN}" _hex HEX)
string(LENGTH "${_hex}" _hexlen)
math(EXPR _nbytes "${_hexlen} / 2")
if(_nbytes LESS 1)
    message(FATAL_ERROR "kernel source is empty: ${KERNEL_IN}")
endif()

set(_hexdigits "0123456789abcdef")
set(_lines "")
set(_cur "")
set(_rt "")
set(_sum 0)

math(EXPR _last "${_nbytes} - 1")
foreach(_i RANGE 0 ${_last})
    math(EXPR _off "${_i} * 2")
    string(SUBSTRING "${_hex}" ${_off} 2 _byte)
    if(_byte STREQUAL "00")
        message(FATAL_ERROR "kernel source contains a NUL byte at offset ${_i}; refusing to embed")
    endif()
    # hex pair -> decimal value
    string(SUBSTRING "${_hex}" ${_off} 1 _hi)
    math(EXPR _off2 "${_off} + 1")
    string(SUBSTRING "${_hex}" ${_off2} 1 _lo)
    set(_dec 0)
    if(_hi MATCHES "[0-9]")
        math(EXPR _dec "${_dec} + ${_hi} * 16")
    elseif(_hi STREQUAL "a")
        math(EXPR _dec "${_dec} + 160")
    elseif(_hi STREQUAL "b")
        math(EXPR _dec "${_dec} + 176")
    elseif(_hi STREQUAL "c")
        math(EXPR _dec "${_dec} + 192")
    elseif(_hi STREQUAL "d")
        math(EXPR _dec "${_dec} + 208")
    elseif(_hi STREQUAL "e")
        math(EXPR _dec "${_dec} + 224")
    elseif(_hi STREQUAL "f")
        math(EXPR _dec "${_dec} + 240")
    endif()
    if(_lo MATCHES "[0-9]")
        math(EXPR _dec "${_dec} + ${_lo}")
    elseif(_lo STREQUAL "a")
        math(EXPR _dec "${_dec} + 10")
    elseif(_lo STREQUAL "b")
        math(EXPR _dec "${_dec} + 11")
    elseif(_lo STREQUAL "c")
        math(EXPR _dec "${_dec} + 12")
    elseif(_lo STREQUAL "d")
        math(EXPR _dec "${_dec} + 13")
    elseif(_lo STREQUAL "e")
        math(EXPR _dec "${_dec} + 14")
    elseif(_lo STREQUAL "f")
        math(EXPR _dec "${_dec} + 15")
    endif()
    # decimal value -> fixed-width octal escape (\ooo, never greedy like \x)
    math(EXPR _oct "${_dec} / 64")
    math(EXPR _rem "${_dec} % 64")
    math(EXPR _oct2 "${_rem} / 8")
    math(EXPR _oct3 "${_rem} % 8")
    string(APPEND _cur "\\${_oct}${_oct2}${_oct3}")
    # decimal value -> hex pair (round-trip verification)
    math(EXPR _dh "${_dec} / 16")
    math(EXPR _dl "${_dec} % 16")
    string(SUBSTRING "${_hexdigits}" ${_dh} 1 _dhc)
    string(SUBSTRING "${_hexdigits}" ${_dl} 1 _dlc)
    string(APPEND _rt "${_dhc}${_dlc}")
    # rolling 32-bit checksum (embedded for the runtime self-test)
    math(EXPR _sum "(${_sum} * 31 + ${_dec}) % 4294967296")
    # wrap the C++ source line every 24 bytes; only a real newline, no escape
    math(EXPR _mod "${_i} % 24")
    if(_mod EQUAL 23)
        string(APPEND _lines "    \"${_cur}\"\n")
        set(_cur "")
    endif()
endforeach()
if(NOT _cur STREQUAL "")
    string(APPEND _lines "    \"${_cur}\"\n")
endif()

if(NOT _rt STREQUAL _hex)
    message(FATAL_ERROR "embed round-trip check failed for ${KERNEL_IN}: octal escapes do not decode back to the input bytes")
endif()

set(_hdr "")
string(APPEND _hdr "#pragma once\n")
string(APPEND _hdr "namespace slimegpu {\n")
string(APPEND _hdr "// generated by scripts/embed_kernel.cmake from src/gpu/slime_kernel.cl\n")
string(APPEND _hdr "// byte-exact octal escapes; ASCII-only header, content identical to the .cl byte stream\n")
string(APPEND _hdr "static const char kSlimeKernelSource[] =\n")
string(APPEND _hdr "${_lines}")
string(APPEND _hdr "    ;\n")
string(APPEND _hdr "static const unsigned long long kSlimeKernelBytes = ${_nbytes}ULL;\n")
string(APPEND _hdr "static const unsigned long long kSlimeKernelChecksum = ${_sum}ULL;\n")
string(APPEND _hdr "} // namespace slimegpu\n")
file(WRITE "${KERNEL_OUT}" "${_hdr}")
message(STATUS "embedded kernel (byte-exact): ${KERNEL_IN} -> ${KERNEL_OUT} (${_nbytes} bytes, checksum ${_sum})")
