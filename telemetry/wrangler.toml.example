name = "slimefinder-telemetry"
main = "worker.js"
compatibility_date = "2026-11-01"

# 先创建 D1：npx wrangler d1 create slimefinder-telemetry
# 把返回的 database_id 填到下面
[[d1_databases]]
binding = "DB"
database_name = "slimefinder-telemetry"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

# 可选：查询统计的 token：npx wrangler secret put STATS_TOKEN
