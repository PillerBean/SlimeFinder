// app.rc - Windows 版本资源 + 程序图标（v3.3.9）
//
// 目的：让「SlimeFinder.exe → 右键属性 → 详细信息」显示正确的文件版本/产品版本（3.10.9）。
// 版本号与代码中的 v3.5.9 保持同步（src/main.cpp 的 kVersion、src/gui/MainWindow.cpp 的 kAppVersion）。
// 说明：#pragma code_page(65001) 让 rc.exe 以 UTF-8 解析本文件，中文字符串不会乱码。
#pragma code_page(65001)

// APP_VERSION 是本仓库「当前构建版本」的单一事实来源（scripts/audit_corruption.py 读取它，
// 再用它校验 main.cpp / README / CMakeLists / install.nsi 中的版本字面量）。
#define APP_VERSION "3.13.4.0"  // 4 段式：审计脚本按「去掉最后一段」推导当前版本 3.11.1

#include <windows.h>

// v3.3.9（任务书 5.1）：程序图标（exe 文件图标 / 资源管理器 / 任务栏 / 标题栏）。
// 素材：新树内 icons 资源（透明底），多尺寸 ICO（16/24/32/48/64/128/256）。
// 图标所在目录由 CMake 传入 rc 的 /I 参数（见 CMakeLists.txt 的 RC 编译选项）。
#define IDI_APPICON 101
IDI_APPICON ICON "appicon.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION 3,13,4,0
    PRODUCTVERSION 3,13,4,0
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
    FILEFLAGS 0x0L
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0804 = 简体中文, 04B0 = Unicode
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "SlimeFinder"
            VALUE "FileDescription",  "史莱姆区块查找器（Slime Chunk Finder）"
            VALUE "FileVersion",      "3.13.4"
            VALUE "InternalName",     "SlimeFinder"
            VALUE "LegalCopyright",   "本程序开发借助多个 AI 编程加速；基岩版算法由 @protolambda / @jocopa3 逆向工程得出"
            VALUE "OriginalFilename", "SlimeFinder.exe"
            VALUE "ProductName",      "史莱姆区块查找器"
            VALUE "ProductVersion",   "3.13.4"
            VALUE "Comments",         "Minecraft 史莱姆区块查找工具（C++20 / Qt 6 重构版）"
        END
        // 0409 = 英文（美国）, 04B0 = Unicode
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "SlimeFinder"
            VALUE "FileDescription",  "Slime Chunk Finder"
            VALUE "FileVersion",      "3.12.3"
            VALUE "InternalName",     "SlimeFinder"
            VALUE "LegalCopyright",   "Built with AI assistance; Bedrock algorithm reverse-engineered by @protolambda / @jocopa3"
            VALUE "OriginalFilename", "SlimeFinder.exe"
            VALUE "ProductName",      "Slime Chunk Finder"
            VALUE "ProductVersion",   "3.12.3"
            VALUE "Comments",         "Minecraft slime chunk finder (C++20 / Qt 6)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200, 0x409, 1200
    END
END
